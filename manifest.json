{
  "manifest_version": 3,
  "name": "Unfollow Local para Instagram",
  "description": "Compara varreduras locais dos seus seguidores e mostra quem deixou de seguir.",
  "version": "1.1.0",
  "minimum_chrome_version": "102",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://www.instagram.com/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Unfollow Local",
    "default_popup": "src/popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "js": [
        "src/content/instagram-scanner.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
